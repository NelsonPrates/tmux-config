#!/usr/bin/env bash
# tmux-sysstat - low-overhead system stats collector for the tmux status line.
#
# Every $TMUX_SYSSTAT_INTERVAL seconds (default 2) it samples CPU, memory,
# WiFi throughput, root disk usage and battery, then publishes the results as
# tmux global user options. The status line only references #{@sys_*}
# variables, so tmux never forks a #() job on redraw.
#
# Options published:
#   @sys_cpu_bar  @sys_cpu   CPU usage: 5-block bar + "NNN%"
#   @sys_mem_bar  @sys_mem   memory usage: 5-block bar + "NNN% U.U/TG"
#   @sys_wifi                WiFi rate "↓  1.2M ↑  300K" (or "no wifi"/"down")
#   @sys_disk                root filesystem "NNN% (  33G free)"
#   @sys_bat                 battery "↑ <4-block bar> NNN%" (empty if none)
#   @sys_user                user name (set once at startup)
#
# Every value has a fixed width so the status line does not shift around.
#
# Lifecycle: started by tmux.conf.local with `run -b`. A lock file keeps a
# single instance per tmux server, and the loop exits as soon as it can no
# longer talk to the server.
#
# Cost: the loop uses bash builtins only; each cycle forks exactly one `tmux`
# client, plus one `df` every DISK_EVERY cycles.
#
# Requires: Linux (/proc, /sys), bash >= 5.0 (EPOCHREALTIME, namerefs), flock.

INTERVAL=${TMUX_SYSSTAT_INTERVAL:-2}
DISK_EVERY=15            # refresh disk usage every 15 cycles (30s by default)
SYM_FULL='◼'
SYM_EMPTY='◻'
# Oh my tmux! "gradient" palette, red -> green
GRADIENT=(colour196 colour202 colour208 colour214 colour220 colour226 colour190 colour154 colour118 colour82 colour46)
BAT_CHARGING='↑'
BAT_DISCHARGING='↓'

# --- single instance per tmux server ---------------------------------------
sock=${TMUX%%,*}
lock="${XDG_RUNTIME_DIR:-/tmp}/tmux-sysstat-$UID-${sock//\//_}.lock"
exec 9>"$lock"
flock -n 9 || exit 0

# interruptible sleep without forking `sleep`
exec {sleep_fd}<> <(:)
nap() { read -r -t "$1" -u "$sleep_fd" || :; }

# --- bars --------------------------------------------------------------------

# sample_palette <out-array> <length> <palette...>
# Picks block colors the same way as Oh my tmux!'s _bar (awk $(1 + i*NF/n)).
sample_palette() {
  local -n _out=$1; local len=$2; shift 2; local p=("$@") n=$# i
  _out=()
  for ((i = 0; i < len - 1; i++)); do _out+=("${p[i * n / len]}"); done
  _out+=("${p[n - 1]}")
}
REVERSED=(); for ((i = ${#GRADIENT[@]} - 1; i >= 0; i--)); do REVERSED+=("${GRADIENT[i]}"); done
sample_palette LOAD_COLORS 5 "${REVERSED[@]}"   # CPU / MEM: green (idle) -> red (busy)
sample_palette BAT_COLORS 4 "${GRADIENT[@]}"    # battery:   red (empty) -> green (full)

# bar <percent> <colors-array> -> sets $BAR
# Leaves fg on the last filled block's color so the following text matches it.
bar() {
  local -n _c=$2; local len=${#_c[@]} i out=''
  local full=$(( ($1 * len + 50) / 100 ))
  for ((i = 0; i < len; i++)); do
    if ((i < full)); then out+="#[fg=${_c[i]}]$SYM_FULL"
    else out+="#[fg=${_c[i]}]$SYM_EMPTY"; fi
  done
  BAR="$out#[fg=${_c[full > 0 ? full - 1 : 0]}]"
}

# --- formatting --------------------------------------------------------------

# human <bytes/s> -> sets $HUMAN, always 6 columns ("    0B", "  999K", "  1.2M")
human() {
  local b=$1 t
  if ((b >= 1048523162)); then                 # >= 999.95M -> G
    t=$(( (b * 10 + 536870912) / 1073741824 )); printf -v HUMAN '%3d.%dG' $((t / 10)) $((t % 10))
  elif ((b >= 1023488)); then                  # >= 999.5K  -> M
    t=$(( (b * 10 + 524288) / 1048576 )); printf -v HUMAN '%3d.%dM' $((t / 10)) $((t % 10))
  elif ((b >= 1000)); then
    printf -v HUMAN '%5dK' $(( (b + 512) / 1024 ))
  else
    printf -v HUMAN '%5dB' "$b"
  fi
}

# --- collectors --------------------------------------------------------------

read_cpu() { local _; read -r _ u n s i w q sq st _ < /proc/stat; CPU_T=$((u+n+s+i+w+q+sq+st)); CPU_I=$((i+w)); }

wifi_iface() {
  local d
  for d in /sys/class/net/*/wireless; do
    [[ -d $d ]] && { d=${d%/wireless}; IFACE=${d##*/}; return 0; }
  done
  IFACE=''; return 1
}

read_net() {
  RX=0; TX=0; NET_UP=0
  [[ -n $IFACE && -r /sys/class/net/$IFACE/statistics/rx_bytes ]] || return
  local st; read -r st < "/sys/class/net/$IFACE/operstate"; [[ $st == up ]] && NET_UP=1
  read -r RX < "/sys/class/net/$IFACE/statistics/rx_bytes"
  read -r TX < "/sys/class/net/$IFACE/statistics/tx_bytes"
}

# Same rules as Oh my tmux!: average capacity of every */power_supply/*bat*
# (skipping peripheral devices), "discharging" if any battery is -> sets $BAT
battery() {
  local d cap st scope sum=0 cnt=0 dis=0
  BAT=''
  for d in /sys/class/power_supply/*; do
    [[ ${d##*/} == *[Bb][Aa][Tt]* ]] || continue
    scope=''; [[ -r $d/scope ]] && read -r scope < "$d/scope"
    [[ ${scope,,} == *device* ]] && continue
    [[ -r $d/capacity ]] || continue
    read -r cap < "$d/capacity"; ((cap > 100)) && cap=100
    read -r st < "$d/status"; [[ ${st,,} == discharging ]] && dis=1
    sum=$((sum + cap)); cnt=$((cnt + 1))
  done
  ((cnt > 0)) || return
  local pct=$((sum / cnt)) sym=$BAT_CHARGING
  ((dis)) && sym=$BAT_DISCHARGING
  bar "$pct" BAT_COLORS
  printf -v BAT '%s %s%3d%%' "$sym" "$BAR" "$pct"
}

# --- main loop ---------------------------------------------------------------

tmux set -gq @sys_user "${USER:-$(id -un)}" 2>/dev/null || exit 0

wifi_iface
read_cpu; pt=$CPU_T; pi=$CPU_I
read_net; prx=$RX; ptx=$TX
cycle=0; DISK=''
t_prev=$EPOCHREALTIME

while :; do
  nap "$INTERVAL"
  t_now=$EPOCHREALTIME
  # elapsed ms (EPOCHREALTIME uses the locale's decimal separator: '.' or ',')
  a=${t_prev//[.,]/}; b=${t_now//[.,]/}; ms=$(( (10#$b - 10#$a) / 1000 )); ((ms > 0)) || ms=1
  t_prev=$t_now

  # CPU
  read_cpu
  dt=$((CPU_T - pt)); di=$((CPU_I - pi)); pt=$CPU_T; pi=$CPU_I
  cpu=0; ((dt > 0)) && cpu=$(( (dt - di) * 100 / dt ))
  bar "$cpu" LOAD_COLORS; cpu_bar=$BAR; printf -v cpu_txt '%3d%%' "$cpu"

  # memory: used = MemTotal - MemAvailable
  mt=0; ma=0
  while read -r k v _; do
    case $k in MemTotal:) mt=$v ;; MemAvailable:) ma=$v; break ;; esac
  done < /proc/meminfo
  mem=0; ((mt > 0)) && mem=$(( (mt - ma) * 100 / mt ))
  bar "$mem" LOAD_COLORS; mem_bar=$BAR
  tg=$(( (mt + 524288) / 1048576 )); ut=$(( ((mt - ma) * 10 + 524288) / 1048576 ))
  printf -v mem_txt "%3d%% %$(( ${#tg} + 2 ))s/%dG" "$mem" "$((ut / 10)).$((ut % 10))" "$tg"

  # WiFi (re-detect the interface if it went away, e.g. after suspend)
  [[ -n $IFACE && -d /sys/class/net/$IFACE ]] || { wifi_iface; read_net; prx=$RX; ptx=$TX; }
  read_net
  if [[ -z $IFACE ]]; then wifi='    no wifi    '
  elif ((NET_UP == 0)); then wifi='     down      '
  else
    human $(( (RX - prx) * 1000 / ms )); r=$HUMAN
    human $(( (TX - ptx) * 1000 / ms )); t=$HUMAN
    wifi="↓$r ↑$t"
  fi
  prx=$RX; ptx=$TX

  # disk usage of the root filesystem (changes slowly)
  if ((cycle % DISK_EVERY == 0)); then
    { read -r _; read -r _ _ _ avail pct _; } < <(LC_ALL=C df -h /)
    printf -v DISK '%4s (%5s free)' "$pct" "$avail"
  fi
  ((cycle++))

  battery

  tmux set -gq @sys_cpu_bar "$cpu_bar" \; set -gq @sys_cpu "$cpu_txt" \
       \; set -gq @sys_mem_bar "$mem_bar" \; set -gq @sys_mem "$mem_txt" \
       \; set -gq @sys_wifi "$wifi" \; set -gq @sys_disk "$DISK" \
       \; set -gq @sys_bat "$BAT" 2>/dev/null || exit 0
done
